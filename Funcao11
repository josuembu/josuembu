programa
{
//. Crie uma função chamada filtrarMaiores(lista, limite) que receba:
//• um array de números
//• um número limite
//A função deve retornar um novo array contendo apenas os elementos do array original
//que sejam maiores que o limite. Números melhores devem ser substituídos por -1.
//No programa principal:
//1. Leia 6 números do usuário e armazene em um array
//2. Leia um valor para o limite
//3. Chame filtrarMaiores(lista, limite)
//. Mostre o array filtrado ao usuário
	funcao inteiro FiltrarMaiores(inteiro lista[],inteiro limite){
		inteiro resultado[6]
		inteiro i
		para(i=0;i<6;i++){
			se(lista[i]>limite){
				resultado[i]=lista[i]
			}
			senao{
				resultado[i]=-1
			}
		}
		retorne resultado[i]
	}
	
	funcao inicio()
	{
	inteiro numeros[6]
	inteiro limite ,i
	inteiro filtrado[6]
	inteiro  lista[6]
	para(i=0;i<6;i++){
		escreva("digite um numero ")
		leia(lista[i])
		
	}
	escreva("digite o limite: ")
	leia(limite)
	filtrado[i]= FiltrarMaiores(lista,limite)
	para(i=0;i<6;i++){
		escreva("\nArray filtrado: \n")
	}
	para(i=0;i<6;i++){
		escreva(filtrado[i], " ")
	}
	
	}
}
